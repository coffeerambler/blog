# Set in .env.local only. Do not commit the value.
ADMIN_PASSWORD=

# OpenAI key for Find 3 ideas and Write this post. The model is gpt-6.1-sol.
# Set in .env.local only. Do not commit the value.
OPENAI_API_KEY=

# Google AdSense publisher ID (ca-pub-…). Leave empty to keep labelled placeholders.
# Set in the host environment or .env.local. Do not commit the ID.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional gtag / Google Ads ID.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Analytics 4 measurement ID (G-…). Leave empty to keep the visit count off.
# Set in .env.local or the host environment.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Search Console HTML tag, the content value only. Leave empty until you verify this app.
GOOGLE_SITE_VERIFICATION=

# Optional numeric AdSense unit IDs for each labelled slot.
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
