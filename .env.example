# Set in .env.local only. Do not commit the value.
ADMIN_PASSWORD=

# Google AdSense publisher ID (ca-pub-…). Leave empty to keep labelled placeholders.
# Set in the host environment or .env.local. Do not commit the ID.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional gtag / Google Ads ID.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Optional numeric AdSense unit IDs for each labelled slot.
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
